APP_ORIGIN=http://localhost:3000
DATA_DIR=./.data
BETTER_AUTH_SECRET=change-me-in-production
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Optional but recommended in production so Server Action IDs remain stable across instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=f5hCEQdkp9SX3zUBRl6dNsJHPunZ7b1dCCtMywGX2ZM=

# Steam integration
STEAM_API_KEY=

# RAWG integration
RAWG_API_KEY=

# MyAnimeList integration
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:3000/api/integrations/mal/callback

# Media pipeline
IMAGE_MAX_UPLOAD_BYTES=8388608
REMOTE_IMAGE_MAX_BYTES=26214400
REMOTE_HTTP_TIMEOUT_MS=15000

# Comma-separated genres that mark an item as NSFW during MAL sync + backfill.
# Empty disables genre-based NSFW flagging.
NSFW_GENRES=
